# URL de la base de datos. Comprobá el driver que usás.
# Para SQLite:
DATABASE_URL=sqlite:///./tienda.db
# Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/tienda

# Modo debug (imprime SQL en consola)
DEBUG=true

# Nombre de la app (aparece en docs)
APP_NAME=Mi API de Tienda
