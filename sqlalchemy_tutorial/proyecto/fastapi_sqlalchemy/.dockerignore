# =============================================================================
# .dockerignore: archivos que NO se copian al contexto de Docker
# Reduce el tamaño del build y evita copiar secretos
# =============================================================================

# Git
.git/
.gitignore

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Entornos virtuales
venv/
env/
.venv/
ENV/

# Tests y artefactos
.pytest_cache/
.coverage
htmlcov/
tests/

# Base de datos local (la DB va en un volumen, no en la imagen)
*.db
*.sqlite
*.sqlite3

# Variables de entorno (NUNCA subir el .env real)
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker mismo (no recursión)
Dockerfile
.dockerignore
docker-compose*.yml

# Documentación (opcional)
README.md
*.md